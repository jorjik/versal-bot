# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleToken

# Ключ подписи QR-кодов (обязательно сменить на случайный!)
SECRET_KEY=change-me-to-a-random-string

# База данных. Для локальной разработки — SQLite (по умолчанию).
# Для продакшена — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://versal:versal@localhost:5432/versal
DATABASE_URL=sqlite+aiosqlite:///./data/versal.db

# Telegram ID администраторов через запятую
ADMIN_IDS=111111111,222222222

# Telegram ID охраны/хостес через запятую (могут валидировать QR)
STAFF_IDS=333333333

# Лимит мест в Guest List на вечер (админ может менять из бота)
GUEST_LIST_LIMIT=100

# Время закрытия бесплатного входа
GUEST_LIST_DEADLINE=20:00
